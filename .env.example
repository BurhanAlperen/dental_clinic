# ===========================================
# Turhal Diş Kliniği — Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env.local olarak kopyalayın ve kendi değerlerinizle doldurun.
# ===========================================

# Veritabanı (MySQL / Prisma)
# Örnek: mysql://kullanici:sifre@localhost:3306/veritabani_adi
DATABASE_URL="mysql://root:parola@localhost:3306/klinik_db"

# NextAuth / Auth.js Güvenlik Anahtarı
# Terminalden üretmek için: openssl rand -base64 32
AUTH_SECRET="gizli_anahtarinizi_buraya_yazin"

# İlk Super Admin Oluşturma Scripti (scripts/create-admin.mjs) için E-posta
ADMIN_EMAIL="admin@turhaldisklinigi.com"

# Site URL (Geliştirme için http://localhost:3000, Canlı için https://alanadiniz.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Places API (İsteğe bağlı - Google Maps yorumları için)
# GOOGLE_PLACES_API_KEY=your_google_api_key_here
# GOOGLE_PLACE_ID=ChIJ-87JZZbtfUARNs3f5Jv9rQs

# Instagram Graph API (İsteğe bağlı)
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# INSTAGRAM_USER_ID=your_instagram_user_id_here

# Klinik E-posta (İsteğe bağlı)
# NEXT_PUBLIC_CLINIC_EMAIL=info@turhaldisklinigi.com
